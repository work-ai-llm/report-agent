# Copy to .env and fill values: cp .env.example .env

# --- LLM ---
MISTRAL_API_KEY=sk-...  # https://console.mistral.ai/api-keys
# Rate limits: 1 req/s per key, see report_agent.py:199 InMemoryRateLimiter(0.05)

# --- Observability (optional, graceful fallback if unreachable) ---
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_BASE_URL=http://{ip}:3000
# If LANGFUSE_* missing/unreachable, report_agent.py:150 _init_langfuse() falls back to no-op handler

# --- Database: Postgres (remote) or SQLite fallback (local) ---
# If POSTGRES_URI set and reachable (connect_timeout=3), uses AsyncPostgresSaver/Store
# If missing/unreachable, falls back to agent/agent_session.db (AsyncSqliteSaver/Store, WAL mode)
# See report_agent.py:55 LOCAL_DB_PATH, report_agent.py:251 _init_pool()
POSTGRES_URI=postgresql://{login}:{pass}@{db_ip}:5432/{db_name}?sslmode=disable
# Alternative local-only: leave empty to force SQLite
# POSTGRES_URI=

# --- Logging (selectable at import, no code change) ---
# report_agent.py:37 LOG_LEVEL env controls all loggers
# Best practice vs hard-coded DEBUG: use env, professional codebases use getLogger(__name__) + env/dictConfig
LOG_LEVEL=INFO  # INFO (default, clean), DEBUG (verbose: httpx/langchain/aiosqlite every PRAGMA/SELECT), WARNING
# Examples:
# LOG_LEVEL=DEBUG  -> shows llm http api calls, db PRAGMAs (what you needed for debugging)
# LOG_LEVEL=INFO   -> fallback messages + agent steps, no aiosqlite spam
# LOG_LEVEL=WARNING -> only warnings/errors
