# Copy to .env and fill values: cp .env.example .env

# --- LLM backend selector ---
# Choose one of: openai_local (OpenAI-compatible server), openrouter, mistral
# If unset, inferred: LLM_BASE_URL → openai_local, OPENROUTER → openrouter, else mistral
LLM_BACKEND=openai_local

# --- Model ids (override per-backend defaults) ---
AGENT_MODEL=ornith
AGENT_EMULATOR_MODEL=ornith

# --- OpenAI-compatible server (e.g. llama.cpp model server) ---
LLM_BASE_URL=http://100.89.7.40:8050/v1   # tailscale: model server /v1 proxy
LLM_API_KEY=                   # secret returned by model server /launch
# Left empty is safe: report_agent.py reads it as
#   os.getenv("LLM_API_KEY", "").strip() or "none"
# so an absent, empty or whitespace-only value all resolve to "none".
LLM_MODEL=ornith                # fallback default model id for openai backend

# --- OpenRouter (free-tier models) ---
# OPENROUTER=sk-or-...         # https://openrouter.ai/settings/keys

# --- Mistral ---
MISTRAL_API_KEY=sk-...          # https://console.mistral.ai/api-keys
# Rate limits: 1 req/s per key, see report_agent.py InMemoryRateLimiter

# --- Observability (optional, graceful fallback if unreachable) ---
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_BASE_URL=http://{ip}:3000
# If LANGFUSE_* missing/unreachable, report_agent.py:150 _init_langfuse() falls back to no-op handler

# --- Database: Postgres (remote) or SQLite fallback (local) ---
# If POSTGRES_URI set and reachable (connect_timeout=3), uses AsyncPostgresSaver/Store
# If missing/unreachable, falls back to agent/agent_session.db (AsyncSqliteSaver/Store, WAL mode)
# See report_agent.py:55 LOCAL_DB_PATH, report_agent.py:251 _init_pool()
POSTGRES_URI=postgresql://{login}:{pass}@{db_ip}:5432/{db_name}?sslmode=disable
# Alternative local-only: leave empty to force SQLite
# POSTGRES_URI=

# --- A2A server (agent/a2a_connector.py) ---
# A2A_HOST: IP advertised in the agent card (unset = auto-detect LAN IP).
# The socket always binds 0.0.0.0, so Wi-Fi changes can't break startup.
# A2A_PORT: server port. A2A_SERVER_URL: where acceptance tests connect.
# A2A_HOST=192.168.1.7
# A2A_PORT=9999
# A2A_SERVER_URL=http://127.0.0.1:9999

# --- Logging (selectable at import, no code change) ---
# LOG_LEVEL picks one tier. The root logger carries the floor for the whole
# process and anything not named explicitly inherits it, so unlisted loggers -
# including any library installed later - stay silent.
# LOG_LEVEL=NONE  -> nothing logged at all (default)
# LOG_LEVEL=INFO  -> one line per LLM HTTP request, plus warnings/errors
# LOG_LEVEL=FULL  -> every logger in the process at INFO
# LOG_LEVEL=DEBUG -> every logger in the process at DEBUG
# Note: this governs logging only. Startup and fallback messages in
# report_agent.py are print() calls, so they appear even at NONE.
LOG_LEVEL=NONE
